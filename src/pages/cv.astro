---
import Base from '../layouts/Base.astro';
import { PROJECTS, SKILL_GROUPS } from '../lib/apps';
import { site } from '../lib/site';
import { withBase } from '../lib/paths';

const featured = PROJECTS.slice(0, 3);
---

<Base
  title="CV — Matias Spacech"
  description="Curriculum vitae de Matias Spacech, desarrollador web egresado de TUDAI (UNICEN)."
>
  <main class="simple-mode min-h-dvh px-4 py-8 sm:py-12">
    <div class="no-print mx-auto mb-4 flex max-w-3xl items-center justify-between gap-3">
      <a href={withBase('/')} class="rounded-lg border border-slate-900/15 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-900/5">
        ← Volver al escritorio
      </a>
      <button
        id="print-cv"
        type="button"
        class="rounded-lg bg-[#121722] px-3 py-2 text-xs font-medium text-white transition hover:bg-[#243044]"
      >
        Imprimir / Guardar PDF
      </button>
    </div>

    <article class="print-sheet mx-auto max-w-3xl rounded-2xl border border-slate-900/10 bg-white p-7 sm:p-10">
      <header class="flex flex-col justify-between gap-5 border-b border-slate-900/10 pb-7 sm:flex-row sm:items-start">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-600">Curriculum vitae</p>
          <h1 class="mt-2 font-display text-4xl font-semibold leading-none tracking-tight">Matias Spacech</h1>
          <p class="mt-3 text-base font-medium text-slate-700">Desarrollador Web</p>
          <p class="mt-1 text-sm text-slate-600">Egresado de TUDAI · UNICEN</p>
        </div>
        <div class="space-y-1 text-sm text-slate-600 sm:text-right">
          <p>{site.location}</p>
          <p><a class="text-emerald-800 underline underline-offset-4" href={site.github} target="_blank" rel="noreferrer">github.com/MatiasSpacech</a></p>
          <p class="text-xs text-slate-600">Disponible para trabajar</p>
        </div>
      </header>

      <section class="mt-7">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-600">Perfil</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-700">
          Desarrollador web y de aplicaciones móviles con formación en TUDAI (UNICEN). Experiencia construyendo
          productos completos: interfaces web, aplicaciones Android, APIs y persistencia de datos. Me interesa
          el desarrollo de productos claros, accesibles y mantenibles.
        </p>
      </section>

      <section class="mt-7">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-600">Formación</h2>
        <div class="mt-3">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-sm font-semibold text-slate-900">TUDAI · Universidad Nacional del Centro (UNICEN)</h3>
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">Egresado</span>
          </div>
          <p class="mt-1 text-sm text-slate-600">
            Tecnicatura Universitaria en Desarrollo de Aplicaciones Informáticas.
          </p>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">
            Formación de pregrado orientada a programación y al desarrollo de aplicaciones web y móviles.
          </p>
        </div>
      </section>

      <section class="mt-7">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-600">Proyectos seleccionados</h2>
        <div class="mt-3 space-y-4">
          {featured.map((project) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-sm font-semibold text-slate-900">{project.name}</h3>
                <span class="font-mono text-[10px] text-slate-600">{project.year}</span>
              </div>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">{project.description}</p>
              <p class="mt-1 font-mono text-[10px] text-slate-600">{project.stack.join(' · ')}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-7">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-600">Herramientas</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {SKILL_GROUPS.map((group) => (
            <div>
              <h3 class="text-xs font-semibold text-slate-900">{group.label}</h3>
              <p class="mt-1 text-sm text-slate-600">{group.items.join(' · ')}</p>
            </div>
          ))}
        </div>
      </section>

      <footer class="mt-8 border-t border-slate-900/10 pt-4 font-mono text-[10px] text-slate-600">
        SPACECH.OS · {site.url.replace('https://', '')} · Documento generado desde el portfolio
      </footer>
    </article>
  </main>

  <script>
    document.getElementById('print-cv')?.addEventListener('click', () => window.print());
  </script>
</Base>

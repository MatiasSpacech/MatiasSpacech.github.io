---
import Base from '../layouts/Base.astro';
import { PROJECTS, SKILL_GROUPS, TIMELINE } from '../lib/apps';
import { site } from '../lib/site';
import { withBase } from '../lib/paths';
---

<Base
  title="Matias Spacech — Desarrollador Web | Versión simple"
  description="Versión accesible y convencional del portfolio de Matias Spacech: proyectos, formación en TUDAI, skills y contacto."
>
  <main class="simple-mode min-h-dvh">
    <header class="border-b border-slate-900/10">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-5">
        <a href={withBase('/')} class="flex items-center gap-2 font-display text-sm font-semibold tracking-tight">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-[#121722] text-[#f5f7fb]">▲</span>
          SPACECH.OS
        </a>
        <a href={withBase('/')} class="rounded-lg border border-slate-900/15 px-3 py-2 text-xs font-medium text-slate-700 transition hover:bg-slate-900/5">
          Volver al escritorio
        </a>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-5 py-12 sm:py-16">
      <section class="grid gap-10 lg:grid-cols-[1fr_260px] lg:items-start">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-emerald-700/20 bg-emerald-600/10 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-emerald-800">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            {site.availability}
          </p>
          <h1 class="mt-6 font-display text-5xl font-semibold leading-[0.95] tracking-tight sm:text-6xl">
            Matias<br />Spacech
          </h1>
          <p class="mt-4 font-mono text-xs uppercase tracking-[0.2em] text-slate-600">
            Desarrollador Web · Egresado de TUDAI
          </p>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700">
            Convierto ideas en interfaces rápidas, accesibles y con personalidad. Me formé en <strong>TUDAI</strong>,
            la Tecnicatura Universitaria en Desarrollo de Aplicaciones Informáticas, y construyo aplicaciones web
            y móviles de punta a punta.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="#proyectos"
              class="rounded-xl bg-[#121722] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#243044]"
            >
              Ver proyectos
            </a>
            <a
              href={site.github}
              target="_blank"
              rel="noreferrer"
              class="rounded-xl border border-slate-900/15 px-5 py-3 text-sm font-medium text-slate-800 transition hover:bg-slate-900/5"
            >
              GitHub ↗
            </a>
            <a
              href={withBase('/cv/')}
              class="rounded-xl border border-slate-900/15 px-5 py-3 text-sm font-medium text-slate-800 transition hover:bg-slate-900/5"
            >
              Ver CV
            </a>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-900/10 bg-white p-3 shadow-sm">
          <img
            src={withBase('/avatar.jpg')}
            alt="Avatar de Matias Spacech"
            class="aspect-square w-full rounded-xl object-cover"
            width="460"
            height="460"
            loading="eager"
          />
          <dl class="mt-4 space-y-3 px-1 pb-1 text-sm">
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Ubicación</dt>
              <dd class="mt-0.5 font-medium text-slate-900">{site.location}</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Formación</dt>
              <dd class="mt-0.5 font-medium text-slate-900">TUDAI · UNICEN</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">GitHub</dt>
              <dd class="mt-0.5">
                <a class="font-medium text-emerald-800 underline underline-offset-4" href={site.github} target="_blank" rel="noreferrer">
                  {site.githubHandle}
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <section id="proyectos" class="mt-20 scroll-mt-8">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-600">01 / Proyectos</p>
            <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">Cosas que construí</h2>
          </div>
          <span class="hidden font-mono text-xs text-slate-600 sm:block">{PROJECTS.length} proyectos</span>
        </div>

        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          {PROJECTS.map((project) => (
            <article class="group flex flex-col rounded-2xl border border-slate-900/10 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-lg">
              <div class="flex items-start justify-between gap-3">
                <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-slate-600">{project.kind} · {project.year}</span>
                <a href={project.repo} target="_blank" rel="noreferrer" class="text-slate-600 transition group-hover:text-emerald-800" aria-label={`Abrir ${project.name} en GitHub`}>
                  ↗
                </a>
              </div>
              <h3 class="mt-5 font-display text-xl font-semibold tracking-tight">{project.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{project.description}</p>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {project.stack.map((item) => (
                  <li class="rounded-md bg-slate-900/[0.055] px-2 py-1 font-mono text-[10px] text-slate-600">{item}</li>
                ))}
              </ul>
              <a href={project.repo} target="_blank" rel="noreferrer" class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-emerald-800">
                Ver repositorio <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-600">02 / Sobre mí</p>
        <div class="mt-2 grid gap-10 lg:grid-cols-[1fr_1fr]">
          <div>
            <h2 class="font-display text-3xl font-semibold tracking-tight">Interfaces claras, productos que funcionan.</h2>
            <div class="mt-5 space-y-4 text-base leading-relaxed text-slate-700">
              <p>
                Soy Matias, desarrollador web de Argentina. Me interesa especialmente la intersección entre
                producto, interfaz y datos: que una aplicación sea linda de usar y también sólida por dentro.
              </p>
              <p>
                Trabajé en proyectos que van desde una app Android que sirve partidas de truco por LAN hasta
                una aplicación de notas que guarda archivos Markdown en tu propio disco. Me gusta entender
                el problema completo y llevarlo a una solución concreta.
              </p>
            </div>
          </div>
          <div class="rounded-2xl border border-slate-900/10 bg-white p-6">
            <h3 class="font-display text-lg font-semibold">Formación</h3>
            <p class="mt-2 text-sm font-medium text-slate-900">TUDAI · UNICEN</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">
              Tecnicatura Universitaria en Desarrollo de Aplicaciones Informáticas.
              Formación de pregrado orientada a programación y al desarrollo de aplicaciones web y móviles.
            </p>
            <p class="mt-4 inline-flex rounded-md bg-emerald-600/10 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-emerald-800">
              Egresado
            </p>
          </div>
        </div>
      </section>

      <section class="mt-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-600">03 / Skills</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">Herramientas que uso</h2>
        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          {SKILL_GROUPS.map((group) => (
            <div class="rounded-2xl border border-slate-900/10 bg-white p-6">
              <h3 class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-600">{group.label}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="rounded-lg border border-slate-900/10 px-2.5 py-1.5 text-sm text-slate-700">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs leading-relaxed text-slate-600">
          Prefiero mostrar herramientas concretas antes que porcentajes inventados. El nivel se ve en los proyectos.
        </p>
      </section>

      <section class="mt-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-600">04 / Trayectoria</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight">Formación y práctica</h2>
        <ol class="mt-7 space-y-3">
          {TIMELINE.map((item) => (
            <li class="rounded-2xl border border-slate-900/10 bg-white p-6">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-md bg-slate-900/[0.055] px-2 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">{item.tag}</span>
                <h3 class="font-display text-lg font-semibold">{item.title}</h3>
              </div>
              <p class="mt-2 text-sm font-medium text-slate-700">{item.subtitle}</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="contacto" class="mt-20 scroll-mt-8 rounded-3xl bg-[#121722] p-8 text-white sm:p-10">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/50">05 / Contacto</p>
        <h2 class="mt-2 max-w-2xl font-display text-3xl font-semibold tracking-tight sm:text-4xl">
          ¿Tenés un proyecto o una oportunidad? Hablemos.
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-white/70">
          Estoy abierto a oportunidades de desarrollo web y móvil. La forma más directa de contactarme es por GitHub.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={site.github}
            target="_blank"
            rel="noreferrer"
            class="rounded-xl bg-white px-5 py-3 text-sm font-medium text-[#121722] transition hover:bg-[#dfe6f3]"
          >
            Escribime por GitHub ↗
          </a>
          <a
            href={withBase('/')}
            class="rounded-xl border border-white/20 px-5 py-3 text-sm font-medium text-white transition hover:bg-white/10"
          >
            Volver al escritorio
          </a>
        </div>
      </section>

      <footer class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-slate-900/10 pt-6 text-xs text-slate-600 sm:flex-row sm:items-center">
        <p>SPACECH.OS — construido en Argentina, corriendo en la web.</p>
        <p class="font-mono">v2.6 “Tandil” · {new Date().getFullYear()}</p>
      </footer>
    </div>
  </main>
</Base>

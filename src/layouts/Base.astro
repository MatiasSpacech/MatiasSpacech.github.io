---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { SITE_URL, withBase } from '../lib/paths';
import { site, STACK } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Matias Spacech — Desarrollador Web',
  description = 'Portfolio de Matias Spacech, desarrollador web egresado de TUDAI. Un sistema operativo para explorar proyectos, skills y contacto.',
  image = '/og.png',
} = Astro.props;

const origin = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL(withBase(image), origin);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  jobTitle: site.role,
  url: SITE_URL,
  image: new URL(withBase(site.avatar), origin).toString(),
  sameAs: [site.github],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad Nacional del Centro de la Provincia de Buenos Aires (UNICEN)',
  },
  knowsAbout: [...STACK],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/avatar.jpg')} />
    <meta name="theme-color" content="#05060A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SPACECH.OS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SPACECH.OS — Matias Spacech, desarrollador web" />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <noscript>
      <style>
        .boot-screen {
          display: none !important;
        }
      </style>
    </noscript>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
